    "# Exhaustive square root\n",
    "def simple_square_root(x):\n",
    "    # find a root of a perfect root\n",
    "    ans = 0\n",
    "    while ans **2 < abs(x):\n",
    "        ans += 1\n",
    "    if ans**2 != abs(x):\n",
    "        print(f\"x = {x} is not perfect square root...\")\n",
    "    else:\n",
    "        if x<0:\n",
    "            ans =-ans\n",
    "        print(f\"Square root of {x} is {ans}.\")"
   ]
  },
