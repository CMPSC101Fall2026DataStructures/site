    "def int_cube_root(n: int):\n",
    "    target = abs(n)\n",
    "    k = 0\n",
    "    while k ** 3 < target:\n",
    "        k += 1\n",
    "    if k ** 3 != target:\n",
    "        return None\n",
    "    return k if n >= 0 else -k\n",
    "\n",
