    "def newtons_sqrt_steps(x: float, guess: float = 1.0, tol: float = 1e-4):\n",
    "    if x < 0:\n",
    "        return None, 0\n",
    "    steps = 0\n",
    "    while abs(x - guess * guess) > tol:\n",
    "        guess = guess - (guess * guess - x) / (2 * guess)\n",
    "        steps += 1\n",
    "    return guess, steps\n",
    "\n",
    "\n",
    "print(newtons_sqrt_steps(25))\n",
    "print(newtons_sqrt_steps(26))"
