    "def approx_sqrt(x: float, epsilon: float = 0.001):\n",
    "    if x < 0:\n",
    "        return None, 0\n",
    "    step = epsilon\n",
    "    ans = 0.0\n",
    "    guesses = 0\n",
    "    while abs(ans * ans - x) >= epsilon and ans * ans <= x:\n",
    "        ans += step\n",
    "        guesses += 1\n",
    "    if abs(ans * ans - x) >= epsilon:\n",
    "        return None, guesses\n",
    "    return ans, guesses\n",
    "\n",
    "\n",
    "print(approx_sqrt(25))\n",
    "print(approx_sqrt(26))"
   ]
